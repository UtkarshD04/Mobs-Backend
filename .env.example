PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/mzobs_employer

# Generate with `openssl rand -hex 32` (or similar). Must be a real random
# value in any deployed environment — rotating it later invalidates every
# issued token and logs everyone out, so set it once at deploy time and
# don't change it casually afterwards.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Comma-separated, no trailing slashes. Locally this is the Vite dev ports
# below; once a site is deployed (Render or elsewhere), add its real origin
# here too, e.g.:
#   CORS_ORIGIN=http://localhost:5173,...,https://employee-dashboard.onrender.com,https://app.yourdomain.com
# Origins missing from this list get silently blocked by the browser (not
# the server) — requests will fail CORS preflight from that origin.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177
SEED_ADMIN_EMAIL=admin@solacetech.dev
SEED_ADMIN_PASSWORD=Passw0rd!123
SEED_COMPANY_NAME=Solace Technologies
SEED_STAFF_NAME=Mzobs Ops Admin
SEED_STAFF_EMAIL=ops@mzobs.dev
SEED_STAFF_PASSWORD=Passw0rd!123
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret
FRONTEND_URL=http://localhost:5176
STAFF_FRONTEND_URL=http://localhost:5174
# SMTP creds for password-reset emails. Left blank, the reset link is just
# logged to the server console instead of emailed (fine for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mzobs <no-reply@mzobs.com>

# Web push (browser notifications). Generate with `npx web-push generate-vapid-keys`.
# Left blank, push silently no-ops instead of crashing the server (same pattern as SMTP above).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@mzobs.com

# Left blank, rate limiting uses an in-memory store (fine for a single
# instance). Set this once the backend runs as more than one PM2 cluster
# worker / server instance, so rate limits are shared instead of multiplied
# per-process, e.g. REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=

# "Continue with Google" (employer + employee login/signup). Create an OAuth
# 2.0 Web Client ID at https://console.cloud.google.com/apis/credentials —
# this must be the exact same value as VITE_GOOGLE_CLIENT_ID in
# Landing-Frontend's env, since the backend checks it as the token audience.
# Left blank, Google sign-in fails cleanly with a 503 instead of crashing.
GOOGLE_CLIENT_ID=
